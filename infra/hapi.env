# Non-secret HAPI FHIR settings (B2). Same env-var keys as the official starter
# docker-compose.yml at tag image/v8.12.0-2. Credentials are NOT here: compose injects
# SPRING_DATASOURCE_USERNAME and SPRING_DATASOURCE_PASSWORD from .env.
# Comments sit on their own lines because `docker run --env-file` has no inline comments.

# JDBC URL of HAPI's own Postgres (service hapi-db, database hapi); the app never uses it.
SPRING_DATASOURCE_URL=jdbc:postgresql://hapi-db:5432/hapi
# Postgres JDBC driver; the starter's application.yaml defaults to H2 otherwise.
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
# Read by the starter's application.yaml (${HIBERNATE_DIALECT}); Postgres is not auto-detected.
HIBERNATE_DIALECT=ca.uhn.fhir.jpa.model.dialect.HapiFhirPostgresDialect
# Cap the JVM heap at 1 GB.
JAVA_TOOL_OPTIONS=-Xmx1g
